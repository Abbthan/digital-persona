{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "echo-digital-persona",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "echodigitalpersona.com",
      "custom_domain": true
    },
    {
      "pattern": "www.echodigitalpersona.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": false
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "959e1f8776a449d69ce4f54abe075176"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PERSONA_MEDIA",
      "bucket_name": "digital-persona-ethan"
    }
  ]
}
