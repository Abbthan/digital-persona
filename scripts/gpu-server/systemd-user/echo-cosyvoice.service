[Unit]
Description=ECHO CosyVoice cloned-speech service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/echo/app
ExecStart=/home/user/echo/app/gpu_services/cosyvoice_service/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
