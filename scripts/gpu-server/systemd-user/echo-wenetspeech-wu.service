[Unit]
Description=ECHO WenetSpeech-Wu recognition service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/echo/app
ExecStart=/home/user/echo/app/gpu_services/wenetspeech_wu/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
OOMScoreAdjust=300

[Install]
WantedBy=default.target
