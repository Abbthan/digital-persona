+    @staticmethod
+    def __transition_signature(frame):
+        """Return a compact face-centred descriptor for fast pose matching."""
+        height, width = frame.shape[:2]
+        crop = frame[
+            int(height * 0.08):max(int(height * 0.90), 1),
+            int(width * 0.18):max(int(width * 0.82), 1),
+        ]
+        if crop.size == 0:
+            crop = frame
+        gray = cv2.equalizeHist(cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY))
+        return cv2.resize(gray, (32, 40), interpolation=cv2.INTER_AREA).astype(np.float32)
+
+    def __nearest_idle_transition_frame(self, audiotype, talking_frame):
+        signatures = self.custom_transition_signatures.get(audiotype)
+        if not signatures or talking_frame is None:
+            return self.custom_transition_frame.get(audiotype)
+        reference = self.__transition_signature(talking_frame)
+        scores = [float(np.mean(np.abs(signature - reference))) for signature in signatures]
+        return int(np.argmin(scores)) if scores else self.custom_transition_frame.get(audiotype)
+
