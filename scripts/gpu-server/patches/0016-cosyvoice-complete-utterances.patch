+_SENTENCE_UNIT_RE = re.compile(
+    r'[^.!?\u3002\uff01\uff1f\uff1b;]+[.!?\u3002\uff01\uff1f\uff1b;]+(?:["\u201d\u2019\']+)?'
+    r'|[^.!?\u3002\uff01\uff1f\uff1b;]+$'
+)
+
+
+def _split_live_tts_text(tts_text: str) -> list[str]:
+    """Bound each inference pass while preserving the full utterance."""
+    text = tts_text.strip()
+    if not text:
+        return []
+
+    # Chinese speech is denser per character than English. Both limits retain
+    # enough context for natural prosody while staying below the observed
+    # early-EOS range of a single live generation.
+    has_cjk = bool(re.search(r'[\u3400-\u9fff]', text))
+    max_chars = 70 if has_cjk else 100
+    joiner = "" if has_cjk else " "
+    units = [match.group(0).strip() for match in _SENTENCE_UNIT_RE.finditer(text)]
+    if not units:
+        return [text]
+
+    segments: list[str] = []
+    current = ""
+    for unit_index, unit in enumerate(units):
+        is_final_unit = unit_index == len(units) - 1
+        candidate = f"{current}{joiner}{unit}" if current else unit
+        # A final question/conclusion is the part most often lost to an early
+        # model EOS. Give it an independent generation boundary even when the
+        # preceding sentence group would still fit below max_chars.
+        if current and (is_final_unit or len(candidate) > max_chars):
+            segments.append(current)
+            current = unit
+        else:
+            current = candidate
+    if current:
+        segments.append(current)
+
+    # A single sentence may still be unusually long. Prefer clause boundaries,
+    # then whitespace, without deleting or rewriting any words.
+    bounded: list[str] = []
+    for segment in segments:
+        while len(segment) > max_chars:
+            cut = max(
+                segment.rfind(mark, 0, max_chars + 1)
+                for mark in (", ", "; ", "\uff0c", "\uff1b", " ")
+            )
+            if cut < max_chars // 2:
+                cut = max_chars
+            elif segment[cut:cut + 2] in (", ", "; "):
+                cut += 1
+            bounded.append(segment[:cut].strip())
+            segment = segment[cut:].strip()
+        if segment:
+            bounded.append(segment)
+    return bounded
+
+
