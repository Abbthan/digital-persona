 # is either a different person or too poor a shot (bad angle/lighting) to
 # trust either way, and this endpoint treats both the same: don't use it.
 FACE_MATCH_DISTANCE_THRESHOLD = 0.6
+
+AVATAR_IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png"}
+AVATAR_VIDEO_EXTENSIONS = {".mp4", ".mov", ".webm", ".mkv", ".avi", ".flv"}
+
+
+def _canonical_avatar_source(source_path: str) -> str:
+    """Return an H.264 MP4 source that MuseTalk can decode consistently.
+
+    Browser MediaRecorder only exposes MP4 on some browsers. Chromium
+    generally records WebM, so normalize every uploaded camera/facial clip
+    here instead of pretending a WebM Blob is an MP4 at the frontend.
+    """
+    if not os.path.isfile(source_path):
+        raise ValueError("avatar source file was not found")
+    extension = os.path.splitext(source_path)[1].lower()
+    if extension not in AVATAR_IMAGE_EXTENSIONS | AVATAR_VIDEO_EXTENSIONS:
+        raise ValueError("avatar media must be JPG, PNG, MP4, MOV, or WebM")
+
+    canonical_path = f"{os.path.splitext(source_path)[0]}_musetalk.mp4"
+    if extension in AVATAR_IMAGE_EXTENSIONS:
+        command = [
+            "ffmpeg", "-y", "-loop", "1", "-i", source_path,
+            "-t", "3", "-r", "25", "-c:v", "libx264", "-pix_fmt", "yuv420p",
+            "-an", "-movflags", "+faststart", canonical_path,
+        ]
+    else:
+        command = [
+            "ffmpeg", "-y", "-i", source_path, "-map", "0:v:0", "-an",
+            "-vf", "fps=25", "-c:v", "libx264", "-preset", "veryfast",
+            "-pix_fmt", "yuv420p", "-movflags", "+faststart", canonical_path,
+        ]
+
+    try:
+        subprocess.run(command, check=True, capture_output=True)
+    except FileNotFoundError as error:
+        raise RuntimeError("ffmpeg is required to prepare avatar media") from error
+    except subprocess.CalledProcessError as error:
+        message = error.stderr.decode("utf-8", "replace").strip()
+        raise ValueError(f"couldn't convert avatar media to MP4: {message[-500:]}") from error
+    if not os.path.isfile(canonical_path) or os.path.getsize(canonical_path) == 0:
+        raise ValueError("avatar media conversion produced no MP4 output")
+    logger.info("Avatar source normalized source=%s output=%s", source_path, canonical_path)
+    return canonical_path
 
