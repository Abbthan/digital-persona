+async def _rag_request(url, method, body, headers, query):
+    timeout = aiohttp.ClientTimeout(total=190)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        async with session.request(method, url, data=body, headers=headers, params=query) as resp:
+            return await resp.read(), resp.status, resp.content_type
+
+
+async def _shadow_legacy_rag(tail, method, body, headers, query):
+    try:
+        await _rag_request(
+            f"http://127.0.0.1:9000/api/rag/{tail}", method, body, headers, query,
+        )
+    except Exception:
+        logger.warning("Legacy RAG shadow write failed for %s", tail, exc_info=True)
