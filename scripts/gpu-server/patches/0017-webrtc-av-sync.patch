     # throttle account for whichever queue is actually further behind.
     def get_audio_buffer_size(self) -> int:
         return self.__audio._queue.qsize()
+
+    def get_buffered_duration(self) -> float:
+        """Return real buffered media time, not incomparable packet counts."""
+        return max(
+            self.__video._queue.qsize() * VIDEO_PTIME,
+            self.__audio._queue.qsize() * AUDIO_PTIME,
+        )
+
+    def ensure_media_start(self) -> float:
+        with self.__media_clock_lock:
+            if self.__media_start is None:
+                self.__media_start = time.time()
+            return self.__media_start
 
+    def media_deadline(self, kind: str, frame_count: int) -> float:
+        frame_duration = VIDEO_PTIME if kind == "video" else AUDIO_PTIME
+        return self.ensure_media_start() + frame_count * frame_duration
+
+    def reanchor_media_clock(self, kind: str, frame_count: int) -> None:
+        """Forgive accumulated delay without letting A/V clocks diverge."""
+        frame_duration = VIDEO_PTIME if kind == "video" else AUDIO_PTIME
+        with self.__media_clock_lock:
+            requested_start = time.time() - frame_count * frame_duration
+            if self.__media_start is None or requested_start > self.__media_start:
+                self.__media_start = requested_start
+                mylogger.info(
+                    'shared media clock reanchored by %s frame=%d', kind, frame_count
+                )
+
     def notify(self,eventpoint):
         if self.__container is not None:
             self.__container.notify(eventpoint)
