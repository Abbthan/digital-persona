+        def settle_mouth(previous_frame, current_frame, frame_index, progress):
+            """Ease only the mouth into the destination frame.
 
+            A full-frame cross-fade doubles the eyes, shoulders and background
+            whenever the talking and idle sources are not pixel-identical.
+            Keep the new pose intact and retain a feathered portion of the
+            prior mouth for 200 ms, so lips close/open without visual ghosts.
+            """
+            if previous_frame is None or current_frame is None:
+                return current_frame
+            if previous_frame.shape != current_frame.shape:
+                logger.warning(
+                    "Skipping mouth transition for mismatched frame shapes: %s != %s",
+                    previous_frame.shape,
+                    current_frame.shape,
+                )
+                return current_frame
+
+            try:
+                face_box = self.coord_list_cycle[frame_index]
+                x0, y0, x1, y1 = [int(value) for value in face_box]
+            except (AttributeError, IndexError, TypeError, ValueError):
+                return current_frame
+
+            frame_height, frame_width = current_frame.shape[:2]
+            x0, x1 = max(0, x0), min(frame_width, x1)
+            y0, y1 = max(0, y0), min(frame_height, y1)
+            face_width = x1 - x0
+            face_height = y1 - y0
+            if face_width < 8 or face_height < 8:
+                return current_frame
+
+            mouth_x0 = x0 + int(face_width * 0.16)
+            mouth_x1 = x1 - int(face_width * 0.16)
+            mouth_y0 = y0 + int(face_height * 0.50)
+            mouth_y1 = y0 + int(face_height * 0.94)
+            roi_width = mouth_x1 - mouth_x0
+            roi_height = mouth_y1 - mouth_y0
+            if roi_width < 4 or roi_height < 4:
+                return current_frame
+
+            previous_roi = previous_frame[mouth_y0:mouth_y1, mouth_x0:mouth_x1]
+            current_roi = current_frame[mouth_y0:mouth_y1, mouth_x0:mouth_x1]
+            if previous_roi.shape != current_roi.shape or previous_roi.size == 0:
+                return current_frame
+
+            feather = np.zeros((roi_height, roi_width), dtype=np.float32)
+            cv2.ellipse(
+                feather,
+                (roi_width // 2, roi_height // 2),
+                (max(1, roi_width // 2 - 1), max(1, roi_height // 2 - 1)),
+                0,
+                0,
+                360,
+                1.0,
+                -1,
+            )
+            blur_radius = max(3, (min(roi_width, roi_height) // 8) | 1)
+            feather = cv2.GaussianBlur(feather, (blur_radius, blur_radius), 0)
+            previous_weight = feather[..., None] * max(0.0, 1.0 - float(progress))
+            blended_roi = (
+                previous_roi.astype(np.float32) * previous_weight
+                + current_roi.astype(np.float32) * (1.0 - previous_weight)
+            )
+            result = current_frame.copy()
+            result[mouth_y0:mouth_y1, mouth_x0:mouth_x1] = np.clip(
+                blended_roi, 0, 255
+            ).astype(np.uint8)
+            return result
+
