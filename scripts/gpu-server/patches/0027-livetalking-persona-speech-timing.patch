+def _persist_voice_speech_profile(wav_path, transcription):
+    """Atomically persist aggregate timing; never stores transcript content."""
+    profile = transcription.get("speech_profile")
+    summary = transcription.get("speech_style_summary")
+    profile_path = os.path.splitext(wav_path)[0] + ".speech.json"
+    if not isinstance(profile, dict):
+        return None, None
+    fd, temporary_path = tempfile.mkstemp(
+        suffix=".json", prefix="speech_profile_", dir=os.path.dirname(profile_path)
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as profile_file:
+            json.dump(profile, profile_file, ensure_ascii=False, separators=(",", ":"))
+        os.replace(temporary_path, profile_path)
+    finally:
+        if os.path.exists(temporary_path):
+            os.unlink(temporary_path)
+    return profile, summary if isinstance(summary, str) else None
 
 
